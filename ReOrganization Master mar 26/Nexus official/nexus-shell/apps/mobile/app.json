{
  "expo": {
    "name": "NexusShell",
    "slug": "nexus-shell",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nexusshell",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexusshell.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "NexusShell uses Face ID for secure authentication",
        "NSCameraUsageDescription": "NexusShell uses the camera for device pairing via QR code",
        "NSLocalNetworkUsageDescription": "NexusShell discovers local machines on your network"
      },
      "config": {
        "usesNonExemptEncryption": true
      },
      "entitlements": {
        "com.apple.developer.networking.networkextension": ["packet-tunnel-provider"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E14"
      },
      "package": "com.nexusshell.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-haptics",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5AC8FA"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "nexus-shell"
      }
    }
  }
}
