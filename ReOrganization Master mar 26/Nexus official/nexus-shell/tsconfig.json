{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@nexus/shared-types": ["packages/shared-types/src"],
      "@nexus/protocol": ["packages/nexusflow-protocol/src"],
      "@nexus/terminal-parser": ["packages/terminal-parser/src"],
      "@nexus/ai-models": ["packages/ai-models/src"],
      "@nexus/policy-engine": ["packages/policy-engine/src"],
      "@nexus/ui-kit": ["packages/ui-kit/src"]
    }
  },
  "references": [
    { "path": "packages/shared-types" },
    { "path": "packages/nexusflow-protocol" },
    { "path": "packages/terminal-parser" },
    { "path": "packages/ai-models" },
    { "path": "packages/policy-engine" },
    { "path": "packages/ui-kit" },
    { "path": "server" }
  ],
  "exclude": ["node_modules", "dist", "apps/mobile"]
}
